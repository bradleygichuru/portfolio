---
import Layout from "../layouts/Layout.astro";
import PortfolioOS from "../components/os/PortfolioOS";
import { ReaderBody } from "../components/os/ReaderBody";
import { SITE } from "../data/portfolio";
---

<Layout title={SITE.title} description={SITE.description}>
  <noscript>
    <style is:inline>
      .os-menubar,
      .os-dock,
      .os-titlebar,
      .desktop-icons,
      .os-notification,
      .welcome-actions,
      .welcome-recent,
      .welcome-tip,
      .ios-app-grid,
      .ios-dock,
      .ios-search-pill,
      .ios-widget-actions,
      .ios-widget-foot,
      .ios-status-actions {
        display: none !important;
      }
      .welcome-app {
        justify-content: center;
      }
      .os-window[data-app="welcome"] {
        height: auto !important;
        min-height: 0 !important;
      }
      .reader-fallback {
        display: block !important;
      }
    </style>
    <p class="noscript-banner">
      JavaScript is off — this page is the static README. Every project, skill,
      and contact detail is below.
      <a href="#reader">Jump to the README</a>.
    </p>
  </noscript>

  <PortfolioOS client:load />

  <section
    id="reader"
    class="reader reader-fallback"
    aria-labelledby="reader-title"
  >
    <div class="reader-window">
      <div class="reader-bar">
        <span class="reader-lights" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
        <span class="reader-title">README.md — Editor</span>
        <a class="reader-back" href="#desktop">
          <span class="reader-back-desktop">Back to desktop</span>
          <span class="reader-back-mobile">Back to home</span>
        </a>
      </div>

      <ReaderBody backHref="#desktop" />
    </div>
  </section>
</Layout>
